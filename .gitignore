# 末尾の / を付けない（作業用フォルダでは node_modules がリンクになることがあり、/ つきだとリンクを無視しない）
node_modules
.next/
.env.local
*.tsbuildinfo
next-env.d.ts
.vercel

# Claude Code runtime state (should not be committed)
.claude/scheduled_tasks.lock
.claude/settings.local.json

# Claude Code MCP config (contains absolute paths, personal)
.mcp.json

# Claude Code の作業用フォルダ（リポジトリに入れない）
.claude/worktrees/
